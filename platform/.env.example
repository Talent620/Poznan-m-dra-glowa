# Fundament v2 — zmienne srodowiskowe (skopiuj jako platform/.env)

# --- Baza / kolejka ---------------------------------------------------------
DATABASE_URL=postgresql://diag:change-me@localhost:5432/diag
REDIS_URL=redis://localhost:6379

# --- Control Plane (M1) -----------------------------------------------------
JWT_ACCESS_SECRET=        # >=32 bajty losowe
JWT_REFRESH_SECRET=       # >=32 bajty losowe
ACCESS_TTL=15m
REFRESH_TTL=30d
MFA_ISSUER=DiagPlatform

# --- Data Plane (M2) --------------------------------------------------------
RELAY_PUBLIC_URL=wss://relay.example.com
RELAY_MTLS_CA=            # sciezka do CA wydajacego certy agentow

# --- Tunelowanie ------------------------------------------------------------
TUNNEL_PROVIDER=cloudflare   # cloudflare|tailscale|wireguard
CLOUDFLARE_TUNNEL_TOKEN=

# --- Bezpieczenstwo ---------------------------------------------------------
RATE_LIMIT_PER_MIN=120
IP_ALLOW_LIST=               # opcjonalnie, CIDR-y oddzielone przecinkiem

# --- Automatyzacja ----------------------------------------------------------
WEBHOOK_SIGNING_ALG=hmac-sha256
