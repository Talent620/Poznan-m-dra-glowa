# ============================================================================
#  Kluczyki Poznan madra glowa - konfiguracja
#  Skopiuj ten plik jako  .env  (robi to za Ciebie opcja 1 / setup.ps1).
#  Sekrety (haslo, sekret sesji) zostana wygenerowane automatycznie.
# ============================================================================

# --- Brama lokalna ----------------------------------------------------------
# Port, na ktorym dziala brama na Twoim komputerze (rzadko trzeba zmieniac).
PORT=8080
HOST=127.0.0.1

# --- CO UDOSTEPNIASZ: narzedzie/strona (wersja dla pracownikow przez www) ----
# Adres Twojego narzedzia webowego, np. http://127.0.0.1:3000
# Zostaw puste, aby zobaczyc strone testowa.
UPSTREAM_URL=

# Alternatywnie: folder z plikami statycznymi do serwowania.
STATIC_DIR=

# --- CO UDOSTEPNIASZ: URZADZENIE OBD2 (zeby OBD sie laczylo) ------------------
# DEVICE_HOST - adres adaptera OBD w domowej sieci (np. 192.168.0.50),
#               albo 127.0.0.1 jesli adapter jest na tym samym komputerze.
# DEVICE_PORT - port adaptera. Dla adapterow WiFi OBD / ELM327 czesto 35000.
# Gdy ustawisz DEVICE_PORT, brama automatycznie wlacza most OBD przez WebSocket
# (/obd) - dzieki temu OBD dziala przez ZWYKLY link Cloudflare, bez Tailscale.
DEVICE_HOST=192.168.0.10
DEVICE_PORT=35000

# Port nasluchu starego mostu TCP (tryb Tailscale). Domyslnie = DEVICE_PORT.
DEVICE_LISTEN_PORT=

# --- Dostep -----------------------------------------------------------------
# Generowane automatycznie przez setup.ps1 - nie wpisuj recznie.
ACCESS_PASSWORD=
SESSION_SECRET=
# Jak dlugo wazna jest sesja po zalogowaniu (godziny).
SESSION_TTL_HOURS=12

# --- Staly adres (opcjonalnie) ----------------------------------------------
# Token nazwanego tunelu Cloudflare (staly adres na wlasnej domenie).
CLOUDFLARE_TUNNEL_TOKEN=

# Nazwa wyswietlana na stronie logowania.
BRAND_NAME=Kluczyki Poznań mądra głowa
